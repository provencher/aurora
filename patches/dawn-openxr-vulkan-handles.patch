+bool GetDeviceHandles(WGPUDevice device, VulkanDeviceHandles* outHandles) {
+    if (device == nullptr || outHandles == nullptr) {
+        return false;
+    }
+
+    Device* backendDevice = ToBackend(FromAPI(device));
+    Queue* backendQueue = ToBackend(backendDevice->GetQueue());
+    PhysicalDevice* backendPhysicalDevice = ToBackend(backendDevice->GetPhysicalDevice());
+    if (backendQueue == nullptr || backendPhysicalDevice == nullptr) {
+        return false;
+    }
+
+    *outHandles = {};
+    outHandles->instance = backendDevice->GetVkInstance();
+    outHandles->physicalDevice = backendPhysicalDevice->GetVkPhysicalDevice();
+    outHandles->device = backendDevice->GetVkDevice();
+    outHandles->queue = backendQueue->GetVkQueue();
+    outHandles->queueFamilyIndex = backendDevice->GetGraphicsQueueFamily();
+    outHandles->queueIndex = 0;
+    return outHandles->instance != VK_NULL_HANDLE && outHandles->physicalDevice != VK_NULL_HANDLE &&
+           outHandles->device != VK_NULL_HANDLE && outHandles->queue != VK_NULL_HANDLE &&
+           outHandles->queueFamilyIndex != std::numeric_limits<uint32_t>::max();
+}
+
+WGPUTexture WrapVulkanSwapchainImage(WGPUDevice device, const VulkanSwapchainImageDescriptor* descriptor) {
+    if (device == nullptr || descriptor == nullptr || descriptor->textureDescriptor == nullptr ||
+        descriptor->image == VK_NULL_HANDLE) {
+        return nullptr;
+    }
+
+    Device* backendDevice = ToBackend(FromAPI(device));
+    auto deviceGuard = backendDevice->GetGuard();
+
+    if (backendDevice->ConsumedError(backendDevice->ValidateIsAlive())) {
+        return nullptr;
+    }
+
+    TextureDescriptor reifiedDescriptor =
+        FromAPI(descriptor->textureDescriptor)->WithTrivialFrontendDefaults();
+    UnpackedPtr<TextureDescriptor> textureDescriptor;
+    if (backendDevice->ConsumedError(ValidateAndUnpack(&reifiedDescriptor), &textureDescriptor)) {
+        return nullptr;
+    }
+    if (backendDevice->ConsumedError(ValidateTextureDescriptor(backendDevice, textureDescriptor,
+                                                              AllowMultiPlanarTextureFormat::No))) {
+        return nullptr;
+    }
+    if (backendDevice->ConsumedError(
+            ValidateVulkanImageCanBeWrapped(backendDevice, textureDescriptor),
+            "validating that an OpenXR Vulkan swapchain image can be wrapped with %s.",
+            textureDescriptor)) {
+        return nullptr;
+    }
+
+    Ref<TextureBase> texture =
+        SwapChainTexture::Create(backendDevice, textureDescriptor, descriptor->image);
+    return ToAPI(ReturnToAPI(std::move(texture)));
+}
