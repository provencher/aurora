+using VulkanOpenXRCreateInstanceCallback = ::VkResult (*)(
+    void* userdata,
+    PFN_vkGetInstanceProcAddr pfnGetInstanceProcAddr,
+    const VkInstanceCreateInfo* createInfo,
+    const VkAllocationCallbacks* allocator,
+    VkInstance* instance);
+
+using VulkanOpenXRCreateDeviceCallback = ::VkResult (*)(
+    void* userdata,
+    PFN_vkGetInstanceProcAddr pfnGetInstanceProcAddr,
+    VkInstance instance,
+    VkPhysicalDevice physicalDevice,
+    const VkDeviceCreateInfo* createInfo,
+    const VkAllocationCallbacks* allocator,
+    VkDevice* device);
+
+struct DAWN_NATIVE_EXPORT VulkanOpenXRHooks {
+    void* userdata = nullptr;
+    VulkanOpenXRCreateInstanceCallback createInstance = nullptr;
+    VulkanOpenXRCreateDeviceCallback createDevice = nullptr;
+};
+
+// Dusk OpenXR integration hook. When installed before the Vulkan backend is initialized,
+// Dawn asks the active OpenXR runtime to mediate Vulkan instance/device creation.
+DAWN_NATIVE_EXPORT void SetOpenXRHooks(const VulkanOpenXRHooks* hooks);
+DAWN_NATIVE_EXPORT void ClearOpenXRHooks();
+DAWN_NATIVE_EXPORT const VulkanOpenXRHooks& GetOpenXRHooks();
+DAWN_NATIVE_EXPORT void SetOpenXRDeviceCreateCallback(void* userdata, VulkanOpenXRCreateDeviceCallback callback);
+DAWN_NATIVE_EXPORT VulkanOpenXRCreateDeviceCallback GetOpenXRDeviceCreateCallback(void** userdata);
+
+struct DAWN_NATIVE_EXPORT VulkanDeviceHandles {
+    VkInstance instance = VK_NULL_HANDLE;
+    VkPhysicalDevice physicalDevice = VK_NULL_HANDLE;
+    VkDevice device = VK_NULL_HANDLE;
+    VkQueue queue = VK_NULL_HANDLE;
+    uint32_t queueFamilyIndex = 0;
+    uint32_t queueIndex = 0;
+    uint32_t apiVersion = VK_API_VERSION_1_1;
+};
+
+// Dusk OpenXR integration hook. Returns false if the device is not a Vulkan Dawn device.
+DAWN_NATIVE_EXPORT bool GetDeviceHandles(WGPUDevice device, VulkanDeviceHandles* outHandles);
+
+struct DAWN_NATIVE_EXPORT VulkanSwapchainImageDescriptor {
+    const WGPUTextureDescriptor* textureDescriptor = nullptr;
+    VkImage image = VK_NULL_HANDLE;
+};
+
+// Dusk OpenXR integration hook. Wraps a runtime-owned VkImage without taking ownership of it.
+// The returned WGPUTexture must be released before the runtime releases or destroys the image.
+DAWN_NATIVE_EXPORT WGPUTexture WrapVulkanSwapchainImage(
+    WGPUDevice device,
+    const VulkanSwapchainImageDescriptor* descriptor);
+
